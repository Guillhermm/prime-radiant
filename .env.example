# Copy to .env (gitignored) and fill in only what you need. Nothing here is needed to run the
# app locally, not even with real data: build into data/ as the README says.

# Publish a build to the R2 bucket (docs/deploy.md, "Data hosting"): an R2 API token with
# Object Read and Write on the bucket. Run: node --env-file=.env pipeline/publish.js --in <build dir>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prime-radiant-data

# FIRMS map key for the live proxy, api/live.js (optional; without it the proxy answers 503).
MAP_KEY=
