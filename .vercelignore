# Allowlist: only web/, core/, api/ and the generated data/ are deployed.
# The build generates the synthetic data/ with tools/mock-data.mjs, which reuses the pipeline's
# tile writer and the Brazil outline, so those two files are uploaded too.
/*
!/web
!/core
!/api
!/data
!/vercel.json
!/tools
/tools/*
!/tools/mock-data.mjs
!/pipeline
/pipeline/*
!/pipeline/write-tiles.js
!/pipeline/domain
/pipeline/domain/*
!/pipeline/domain/brazil.geojson
*.test.js
